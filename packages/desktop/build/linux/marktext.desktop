[Desktop Entry]
Name=CraftyText
Comment=Next generation markdown editor
Exec=craftytext %F
Terminal=false
Type=Application
Icon=craftytext
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=craftytext;
StartupWMClass=craftytext
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=craftytext --new-window %F
Icon=craftytext
